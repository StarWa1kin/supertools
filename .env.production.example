# Copy this file to .env.production on the server, then replace every value marked CHANGE_ME.
APP_ENV=production
APP_CORS_ORIGINS=["https://admin.devhooks.cn"]

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password
ADMIN_TOKEN_SECRET=CHANGE_ME_use_at_least_32_random_characters
ADMIN_TOKEN_TTL_SECONDS=43200
DEPLOY_SERVICE_URL=http://deployer:9010
DEPLOY_SERVICE_TOKEN=CHANGE_ME_use_a_separate_32_character_random_secret
# SSH private repository only: directory containing the deploy key and known_hosts.
DEPLOY_SSH_DIR=/root/.ssh

CODEX_WATCH_ACCOUNT=tibo
CODEX_WATCH_KEYWORDS=["codex","quota","limit","reset"]
CODEX_WATCH_DATA_DIR=/app/.data/codex-watch
CODEX_WATCH_SOURCE_URL=https://codex-reset.com
CODEX_WATCH_SOURCE_TIMEOUT_SECONDS=8
# Optional outbound proxy for the Python API.  With Docker Compose, use the
# host gateway instead of 127.0.0.1, which would refer to the API container.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,deployer
WECHAT_REMINDER_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_RESET_TEMPLATE_ID=
WECHAT_RESET_PAGE=pages/codex-watch/index
WECHAT_TEMPLATE_STATUS_KEY=thing1
WECHAT_TEMPLATE_TIME_KEY=time3
WECHAT_TEMPLATE_REMARK_KEY=thing5

VIDEO_PARSER_TIMEOUT_SECONDS=15
VIDEO_PARSER_MAX_REDIRECTS=5
VIDEO_PARSER_MAX_RESPONSE_BYTES=5242880
VIDEO_PARSER_CONCURRENCY=10
VIDEO_MEDIA_TOKEN_TTL_SECONDS=900
VIDEO_MEDIA_SIGNING_SECRET=CHANGE_ME_use_at_least_32_random_characters
VIDEO_MEDIA_MAX_VIDEO_BYTES=209715200
VIDEO_MEDIA_MAX_IMAGE_BYTES=20971520
VIDEO_MEDIA_ALLOWED_HOSTS=["douyinvod.com","douyinpic.com","aweme.snssdk.com","bytecdn.cn","zjcdn.com","kwimgs.com","kwaicdn.com","kuaishou.com","xhscdn.com"]

# Public API origin compiled into the admin frontend.
VITE_API_BASE_URL=https://api.devhooks.cn
# Ports exposed only to the host reverse proxy.
API_BIND_ADDRESS=127.0.0.1
API_HTTP_PORT=8000
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HTTP_PORT=8080

# 应用运行环境（development、production 等）。
APP_ENV=development
# 允许跨域访问 API 的前端来源列表。
APP_CORS_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
# 需要监控的 X（Twitter）账号。
CODEX_WATCH_ACCOUNT=tibo
# 用于筛选帖子的关键词列表。
CODEX_WATCH_KEYWORDS=["codex","quota","limit","reset"]
# 默认使用系统临时目录；生产环境由 Docker 容器路径配置。
# CODEX_WATCH_DATA_DIR=/external/path/codex-watch
# 获取监控帖子的公开来源地址。
CODEX_WATCH_SOURCE_URL=https://codex-reset.com
# 监控来源请求的超时时间（秒）。
CODEX_WATCH_SOURCE_TIMEOUT_SECONDS=8
# 管理后台登录用户名。
ADMIN_USERNAME=admin
# 管理后台登录密码；请使用强密码。
ADMIN_PASSWORD=come2u
# 签发管理员登录令牌的密钥；生产环境须使用强随机值。
ADMIN_TOKEN_SECRET=replace-with-a-long-random-admin-token-secret
# 管理员登录令牌的有效期（秒）。
ADMIN_TOKEN_TTL_SECONDS=43200
# REQUEST_LOG_DATA_DIR=/external/path/request-logs
# 保留的请求日志最大条数。
REQUEST_LOG_MAX_ENTRIES=5000
# 仅在反向代理由你信任并会正确设置 X-Forwarded-For 时启用
# 是否信任反向代理传递的客户端 IP 请求头（true/false）。
REQUEST_LOG_TRUST_PROXY_HEADERS=false
# 自动部署服务的基础地址。
DEPLOY_SERVICE_URL=
# 调用部署服务时携带的认证令牌；请妥善保管。
DEPLOY_SERVICE_TOKEN=
# 请求视频平台的超时时间（秒）。
VIDEO_PARSER_TIMEOUT_SECONDS=15
# 解析分享链接时允许跟随的最大重定向次数。
VIDEO_PARSER_MAX_REDIRECTS=5
# 单次平台响应允许读取的最大字节数。
VIDEO_PARSER_MAX_RESPONSE_BYTES=5242880
# 视频解析任务的最大并发数。
VIDEO_PARSER_CONCURRENCY=10
# 视频媒体访问令牌的有效期（秒）。
VIDEO_MEDIA_TOKEN_TTL_SECONDS=900
# 签发视频媒体访问令牌的密钥；生产环境须使用强随机值。
VIDEO_MEDIA_SIGNING_SECRET=replace-with-a-long-random-production-secret
# 单个视频允许代理的最大字节数。
VIDEO_MEDIA_MAX_VIDEO_BYTES=209715200
# 单个封面图片允许代理的最大字节数。
VIDEO_MEDIA_MAX_IMAGE_BYTES=20971520
# 允许访问远程视频媒体的域名白名单。
VIDEO_MEDIA_ALLOWED_HOSTS=["douyinvod.com","douyinpic.com","aweme.snssdk.com","bytecdn.cn","zjcdn.com","kwimgs.com","kwaicdn.com","kuaishou.com","xhscdn.com"]
# 是否解析 DNS 以加强视频链接的 SSRF 防护（true/false）。
VIDEO_PARSER_RESOLVE_DNS=true

# 可选：API 的出站 HTTP(S) 代理；本地代理通常使用 127.0.0.1。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
